PORT=4317
HOST=127.0.0.1
NODE_ENV=production
DATA_DIR=./data
# Generate separate random values, at least 32 characters each. Never commit .env.
ADMIN_PASSWORD=
SESSION_SECRET=
SERVER_INGEST_KEY=
# Exact production origins only. Inspect and adjust before enabling.
WALLET_ORIGINS=https://wallet.repay.sa
BUSINESS_ORIGINS=https://repay.sa,https://www.repay.sa
POC_ORIGINS=https://repay-poc.onrender.com
# Existing read-only RePay-POC integration. Password stays on this server.
POC_API_ORIGIN=https://repay-poc.onrender.com
POC_ANALYTICS_PASSWORD=
# Optional read-only Google Sheets service-account credentials.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=1s7wtAAzj8JmoERslw3h5W2n-7PltWAnjEL5Omzr1vPE
GOOGLE_SHEET_TITLE=الورقة1
# Use 0 to keep historical events on durable storage.
RETENTION_DAYS=90

# Optional free private Tarout bucket. Keep SESSION_SECRET stable: it also
# protects the encrypted event history. Copy keys only into hosting settings.
TAROUT_BUCKET_ID=
TAROUT_ACCESS_KEY=
TAROUT_SECRET_KEY=

# If the frontend is on GitHub Pages, allow only this exact admin origin.
ADMIN_FRONTEND_ORIGIN=
